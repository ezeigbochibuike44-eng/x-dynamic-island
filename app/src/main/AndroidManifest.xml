<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the island over other apps (user grants it in Settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keep the island service alive on Android 9. Shows one persistent notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Haptic feedback on island gestures (can be turned off in settings). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only asked on Android 13 and newer; ignored on Android 9. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".XApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XDynamicIsland">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

    </application>

</manifest>
